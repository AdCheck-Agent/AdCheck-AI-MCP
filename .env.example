AI_AGENT_PORT=8000
RAG_MCP_PORT=8001
BUSINESS_MCP_PORT=8002
QDRANT_PORT=6333
# Local processes use localhost. Compose overrides these with service names.
RAG_MCP_URL=http://localhost:8001
BUSINESS_MCP_URL=http://localhost:8002
QDRANT_URL=http://localhost:6333
HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
# Only Business service uses this key. Empty key returns unavailable without a provider call.
TAVILY_API_KEY=
# Hard caps: <= 5 seconds, <= 3 results. Automatic retries and Extract are disabled.
TAVILY_TIMEOUT_SECONDS=5
TAVILY_MAX_RESULTS=3
