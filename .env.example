AI_AGENT_PORT=8000
RAG_MCP_PORT=8001
BUSINESS_MCP_PORT=8002
RAG_DB_PORT=5433
RAG_DB_USER=adcheck
RAG_DB_PASSWORD=adcheck
RAG_DB_NAME=adcheck_rag
# 로컬 실행은 localhost를 쓴다. Compose는 이 값을 서비스 이름으로 덮어쓴다.
RAG_MCP_URL=http://localhost:8001
RAG_RETRIEVAL_ENABLED=false
BUSINESS_MCP_URL=http://localhost:8002
RAG_DATABASE_URL=postgresql://adcheck:adcheck@localhost:5433/adcheck_rag
# Compose 전용: 내장 pgvector 대신 rag-mcp가 쓸 외부 DB (Supabase 세션 풀러).
# RAG_COMPOSE_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIM=1024
RAG_MODEL_CACHE=.cache/embeddings
RAG_MAX_UPLOAD_BYTES=5242880
RAG_MAX_ROWS=1000
RAG_MAX_ATTACHED_CHARS=30000
HTTP_TIMEOUT_SECONDS=10
# 백그라운드 검수 제한 시간. HTTP 202는 이미 보냈으므로 시간 초과는 로그로 남긴다.
REVIEW_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
# 선택. 비워 두면 외부 호출 없이 mock 검수기로 실행한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Business 서비스만 이 키를 쓴다. 비어 있으면 Tavily를 호출하지 않고 unavailable을 반환한다.
TAVILY_API_KEY=
# 상한: 5초 이하, 결과 3건 이하. 자동 재시도와 Extract는 쓰지 않는다.
TAVILY_TIMEOUT_SECONDS=5
TAVILY_MAX_RESULTS=3
# 끝난 검수 단계(와 최종 결과)를 Business MCP를 거쳐 BE에 보고한다.
CHECKPOINT_ENABLED=false
# business-mcp에서 본 BE 주소. Compose에서 이 Mac의 BE로 보낼 때: http://host.docker.internal:8080
ADCHECK_BE_BASE_URL=
# BE의 INTERNAL_API_KEY와 같아야 한다(X-Internal-Key로 전송). 예: openssl rand -hex 32
INTERNAL_API_KEY=
